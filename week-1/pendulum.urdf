<?xml version="1.0"?>
<robot name="pend_robot">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.25" length="0.1"/></geometry>
      <material name="cyan"><color rgba="0 0.9 0.9 1.0"/></material>
    </visual>
    <inertial>
      <mass value="100"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="10" ixy="0" ixz="0" iyy="10" iyz="0" izz="10"/>
    </inertial>
  </link>

  <link name="body_link">
    <visual>
      <origin xyz="0 0 0.60" rpy="0 0 0"/>
      <geometry><cylinder radius="0.1" length="1.2"/></geometry>
      <material name="blue"><color rgba="0 0.0 0.9 1.0"/></material>
    </visual>
    <inertial>
      <mass value="5"/>
      <origin xyz="0 0 0.60" rpy="0 0 0"/>
      <inertia ixx="0.6" ixy="0" ixz="0" iyy="0.6" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <link name="motor_link">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry><cylinder radius="0.15" length="0.4"/></geometry>
      <material name="cyan"><color rgba="0 0.9 0.9 1.0"/></material>
    </visual>
    <inertial>
      <mass value="1"/>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <link name="arm_link">
    <visual>
      <origin xyz="0.0 0.0 0.40" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.8"/></geometry>
      <material name="red"><color rgba="0.5 0.0 0.0 1.0"/></material>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0.0 0.0 0.40" rpy="0 0 0"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <link name="ball_link">
    <visual>
      <geometry><sphere radius="0.1"/></geometry>
      <material name="green"><color rgba="0 1 0 1"/></material>
    </visual>
    <inertial>
      <mass value="2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/>
    </inertial>
  </link>

  <joint name="first_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body_link"/>
    <origin xyz="0 0 0.00" rpy="0 0 0"/>
  </joint>

  <joint name="motor_joint" type="continuous">
    <parent link="body_link"/>
    <child link="motor_link"/>
    <origin xyz="0 0 1.20" rpy="0 1.5870 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <joint name="arm_joint" type="fixed">
    <parent link="motor_link"/>
    <child link="arm_link"/>
    <origin xyz="0 0 0.25" rpy="0 1.578 0"/>
  </joint>

  <joint name="arm_joint2" type="fixed">
    <parent link="arm_link"/>
    <child link="ball_link"/>
    <origin xyz="0 0 0.80" rpy="0 0 0"/>
  </joint>

</robot>
